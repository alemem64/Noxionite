      "namedDataRouteRegex": "^/_next/data/k_FUSp0MEgUE7fi4yuFI4/category/(?<nxtPslug>[^/]+?)\\.json$"
    },
    {
      "page": "/feed",
      "dataRouteRegex": "^/_next/data/k_FUSp0MEgUE7fi4yuFI4/feed\\.json$"
    },
    {
      "page": "/post/[...slug]",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "dataRouteRegex": "^/_next/data/k_FUSp0MEgUE7fi4yuFI4/post/(.+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/k_FUSp0MEgUE7fi4yuFI4/post/(?<nxtPslug>.+?)\\.json$"
